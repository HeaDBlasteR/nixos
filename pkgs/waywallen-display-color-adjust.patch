@@ -3,9 +3,20 @@
 import "Plugin" as P
 
 Item {
+    id: surface
+
     property alias display: displayItem
     readonly property bool blurLoaded: blurLoader.status === Loader.Ready
 
+    // Color adjustments in MultiEffect units: -1.0 .. 1.0, 0.0 = unchanged.
+    property real saturation: 0.0
+    property real brightness: 0.0
+    property real contrast: 0.0
+    readonly property bool colorAdjusted: saturation !== 0.0
+                                          || brightness !== 0.0
+                                          || contrast !== 0.0
+    readonly property bool blurPause: displayItem.pauseEffectKind === P.PluginDisplay.BlurPauseEffect
+
     P.PluginDisplay {
         id: displayItem
         anchors.fill: parent
@@ -17,20 +28,27 @@
                                   | P.PluginDisplay.GrowTransitionCapability
     }
 
+    // One MultiEffect handles both the pause blur and the color
+    // adjustments, so a blurred paused frame keeps the same colors.
+    // With no blur pause and no adjustments it is not loaded at all.
     Loader {
         id: blurLoader
         anchors.fill: parent
-        active: displayItem.pauseEffectKind === P.PluginDisplay.BlurPauseEffect
+        active: surface.blurPause || surface.colorAdjusted
         asynchronous: false
 
         sourceComponent: MultiEffect {
             anchors.fill: parent
             source: displayItem
             autoPaddingEnabled: false
-            blurEnabled: true
+            blurEnabled: surface.blurPause
             blurMax: 64
-            blur: displayItem.pauseEffectActive ? displayItem.blurRadius / 64.0 : 0.0
-            visible: displayItem.pauseEffectActive || blur > 0.0
+            blur: surface.blurPause && displayItem.pauseEffectActive
+                  ? displayItem.blurRadius / 64.0 : 0.0
+            saturation: surface.saturation
+            brightness: surface.brightness
+            contrast: surface.contrast
+            visible: surface.colorAdjusted || displayItem.pauseEffectActive || blur > 0.0
 
             Behavior on blur {
                 NumberAnimation { duration: 180; easing.type: Easing.OutCubic }
